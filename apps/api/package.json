{
  "name": "@keyo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "typecheck": "prisma generate >/dev/null && tsc --noEmit",
    "test": "prisma generate >/dev/null && tsx --test src/**/*.test.ts",
    "conversations": "tsx --env-file-if-exists=.env src/tools/conversations.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@keyo/shared": "workspace:^",
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "^5",
    "ioredis": "^5",
    "pg": "8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.1",
    "tsx": "^4.23.15"
  }
}
