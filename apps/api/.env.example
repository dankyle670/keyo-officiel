# Copier en .env (jamais commité). Clé créée sur console.anthropic.com > API Keys.
ANTHROPIC_API_KEY=
# Optionnel
# Modèle choisi automatiquement selon la tâche (src/agent/router.ts) ; remplaçables palier par palier :
# KEYO_MODEL_FAST=claude-haiku-5-5        # salutations, consultations simples, spécialistes de fond
# KEYO_MODEL_STANDARD=claude-sonnet-5-5   # la plupart des demandes, gérant de fond
# KEYO_MODEL_EXPERT=claude-opus-5-5       # fiscalité, droit, valeur, patrimoine, PDF, analyses
# KEYO_MODEL_ADVISOR=claude-opus-5-5      # consulté par Haiku et Sonnet quand ils le jugent utile
# PORT=3000

# Agents autonomes
# REDIS_URL=redis://localhost:6379      # déclencheurs durables (BullMQ) ; sans, minuterie en mémoire
# KEYO_SCHEDULER=off                    # coupe les horaires (les événements restent traités)
# KEYO_API_TOKEN=                       # jeton exigé sur /autonomous (provisoire, avant la connexion par SMS)
# WhatsApp Business (API Cloud de Meta) ; sans, les messages sont simulés
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE=                    # modèle approuvé, obligatoire hors fenêtre de 24 h
