# Copier en .env (jamais commité). Clé créée sur console.anthropic.com > API Keys.
ANTHROPIC_API_KEY=
# Optionnel
# L'agent choisit son modèle selon l'action (packages/shared/src/model-tiers.ts) ; modèles remplaçables :
# KEYO_MODEL_FAST=claude-haiku-5-5        # lire et présenter ; départ de chaque demande
# KEYO_MODEL_STANDARD=claude-sonnet-5-5   # agir, recherche web
# KEYO_MODEL_EXPERT=claude-opus-5-5       # contrats, fiscalité, valeur, patrimoine

# PORT=3000

# Agents autonomes
# REDIS_URL=redis://localhost:6379      # déclencheurs durables (BullMQ) ; sans, minuterie en mémoire
# KEYO_SCHEDULER=off                    # coupe les horaires (les événements restent traités)
# KEYO_API_TOKEN=                       # jeton exigé sur /autonomous (provisoire, avant la connexion par SMS)
# WhatsApp Business (API Cloud de Meta) ; sans, les messages sont simulés
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE=                    # modèle approuvé, obligatoire hors fenêtre de 24 h

# Comptes de paiement : clé de chiffrement des numéros et IBAN (32 octets en base64, ex. openssl rand -base64 32).
# Obligatoire hors du poste de dev.
# KEYO_DATA_KEY=

# Base PostgreSQL (docker-compose up -d postgres). Sans elle : stockage en mémoire.
DATABASE_URL=postgresql://keyo:keyo@localhost:5432/keyo

# Signature des webhooks du prestataire de paiement de l'abonnement (obligatoire hors développement).
# KEYO_WEBHOOK_SECRET=
